# 复制为 /etc/vulnshield.env 后 chmod 600，并在 systemd 中引用 EnvironmentFile=
# Joern（解压后的 joern-cli 根目录，其下应有 bin/joern-parse）
JOERN_PATH=/opt/joern-cli

# LLM（仅国产：deepseek / qwen / wenxin / doubao / kimi / zhipu / hunyuan；勿提交真实密钥）
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 留空则使用各厂商默认 Base；DeepSeek 可显式写：
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# HuggingFace（国内可保持默认镜像；不需要数据集下载可设 HF_USE_MIRROR=0）
# HF_USE_MIRROR=1
# HF_MIRROR_ENDPOINT=https://hf-mirror.com

# Python
PYTHONUNBUFFERED=1
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
